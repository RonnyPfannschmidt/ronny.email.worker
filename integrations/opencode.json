{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mailmind": {
        "type": "local",
        "command": [
          "mailmindctl",
          "mcp",
          "--producer",
          "opencode",
          "--serve",
          "--port",
          "0"
        ],
        "environment": {
          "MAILMIND_CONFIG": "~/.config/mailmind/mailmind.toml"
        }
      }
    }
  }
}
