# Copy to mailmind.toml, or point MAILMIND_CONFIG at it.

database_url = "sqlite:///mailmind.db"

# The review UI's session cookie is a bearer token over plain HTTP, so it refuses to listen
# anywhere but this machine.  Anything else needs something in front of it doing TLS and
# authentication, and `behind_auth_proxy = true` is how you say so — an assertion nothing
# here can check, which is why it is not inferred from the bind address.
# docs/security-model.md has the reasoning.
bind = "127.0.0.1"
port = 8765
# behind_auth_proxy = false

# Accounts below are seed data.  `mailmindctl bootstrap` writes them into `account` rows,
# and the rows are what a connection is built from — so an account added another way works
# without ever being named here.

[limits]
# 05: a request matching more than this returns fewer and says so.
max_messages_per_request = 200
# 03: suggestions nobody gets to expire rather than accumulate.
bundle_expiry_days = 7
body_cache_bytes = 268435456
max_bundle_size = 500

[accounts.personal]
host = "imap.example.org"
port = 993
use_ssl = true
# What this server is declared to be able to do.  `mailmindctl probe` checks the
# declaration against the server and fails loudly on divergence; it never quietly
# downgrades.  Drop CONDSTORE here and conditional applies become best-effort ones that
# say so.  QRESYNC is deliberately absent: a declaration says what the service attempts,
# and nothing here uses it, so demanding it would fail the probe for no gain.
caps = ["CONDSTORE", "MOVE", "UIDPLUS", "SPECIAL-USE", "IDLE"]
# false keeps message bodies out of the local database entirely.
cache_bodies = true

[accounts.personal.login]
username = "me@example.org"
# A URL saying where the password is found — never the password itself:
#
#   secret-storage://imap.example.org           the desktop secret store; the username
#                                               above is the entry, so this is usually
#                                               the whole of it.  Needs `.[secrets]`
#                                               installed and a desktop session to talk
#                                               to.  `keyring set imap.example.org
#                                               me@example.org` puts it there.
#   pass://mail/imap.example.org                password-store, through the `pass`
#                                               command.  The first line of the entry is
#                                               the password; the rest is notes.
#   file://~/.secrets/mailmind-personal         a file with a mode on it.  The headless
#                                               answer: no session bus, no secret store.
#   env://MAILMIND_PERSONAL_PASSWORD            the password is then in your shell
#                                               history and in the environment of every
#                                               process launched from that shell.  Fine
#                                               for a throwaway container, wrong here.
#
# docs/reference/configuration.md has the reasoning.  An unknown scheme is refused when
# the config loads, not when a connection is attempted.
password = "secret-storage://imap.example.org"
